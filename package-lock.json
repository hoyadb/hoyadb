{
  "name": "hoyadb-javascript-workspace",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "hoyadb-javascript-workspace",
      "workspaces": [
        "packages/client",
        "packages/testing"
      ]
    },
    "node_modules/@hoyadb/client": {
      "resolved": "packages/client",
      "link": true
    },
    "node_modules/@hoyadb/testing": {
      "resolved": "packages/testing",
      "link": true
    },
    "packages/client": {
      "name": "@hoyadb/client",
      "version": "0.1.0",
      "license": "MIT"
    },
    "packages/testing": {
      "name": "@hoyadb/testing",
      "version": "0.1.0",
      "dependencies": {
        "@hoyadb/client": "0.1.0"
      },
      "license": "MIT"
    }
  }
}
